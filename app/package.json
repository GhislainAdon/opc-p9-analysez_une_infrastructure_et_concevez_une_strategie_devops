{
  "name": "glossaflow-api",
  "version": "0.1.0",
  "description": "Squelette d'initialisation du pipeline CI/CD GlossaPro (service GlossaFlow API)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --ci --reporters=default --reporters=jest-junit --coverage --coverageReporters=text --coverageReporters=cobertura",
    "lint": "eslint src tests",
    "audit": "npm audit --audit-level=high"
  },
  "license": "MIT",
  "dependencies": {
    "eslint-plugin-security": "^2.1.1",
    "express": "^4.19.2",
    "jest-junit": "^16.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "lines": 40,
        "statements": 40,
        "branches": 40,
        "functions": 40
      }
    }
  },
  "jest-junit": {
    "outputDirectory": "../reports",
    "outputName": "junit.xml"
  }
}
